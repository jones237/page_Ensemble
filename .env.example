# ============================================================
# PageEnsemble — Variables d'environnement
# COPIER ce fichier en .env.local et remplir les valeurs
# NE JAMAIS committer .env.local ou .env.production !
# ============================================================

VITE_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_ICI
VITE_SUPABASE_STORAGE_BUCKET=books_images
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=PageEnsemble

# Optionnel : n8n webhooks (ne jamais mettre une clé privée ici)
VITE_N8N_WEBHOOK_BASE=

# n8n webhook secret (must match X-Webhook-Secret check in your n8n workflow)
VITE_N8N_WEBHOOK_SECRET=change_me_to_a_random_32char_string

# ── Monitoring (Sentry) ─────────────────────────────────────────────────────
# Créer un projet sur https://sentry.io — plan gratuit 5000 events/mois
VITE_SENTRY_DSN=https://XXXX@XXXX.ingest.sentry.io/XXXX

# Version de l'app — utilisée par Sentry pour grouper les erreurs par release
VITE_APP_VERSION=1.0.0

# Variables SERVEUR uniquement (pas de préfixe VITE_) — pour CI/CD
# Ne jamais exposer ces valeurs côté client
SENTRY_AUTH_TOKEN=sntrys_XXXX       # Pour uploader les source maps
SENTRY_ORG=pageensemble              # Slug de votre organisation Sentry
SENTRY_PROJECT=pageensemble-frontend # Nom du projet Sentry
